NODE_ENV=development
PORT=4000

# Public origin of this API (used to build password-reset links)
API_URL=http://localhost:4000

# Where the Next.js frontend runs. Reset links point here.
APP_URL=http://localhost:3000

# Comma-separated CORS allowlist. Must include APP_URL.
CORS_ORIGINS=http://localhost:3000

# Datebase (Supabase)
# DATABASE_URL uses the pooled (pgBouncer, port 6543) connection for the app.
# DIRECT_URL uses the direct (port 5432) connection — Prisma migrations only.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Auth
# Generate each with: openssl rand -base64 48
# These MUST be different from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Cookie domain for the refresh token. Leave blank for localhost.
COOKIE_DOMAIN=

# Supabase Storage (proof-of-payment uploads)
SUPABASE_URL=https://PROJECT.supabase.co
# Service-role key — server-side only. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=proofs

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Sterling Edge Trade <noreply@sterlingedgetrade.com>"
# Where "contact support" replies go
SUPPORT_EMAIL=support@sterlingedgetrade.com

# Seed admin
# Used once by `npm run seed`. Seeding refuses to run with a weak password.
SEED_ADMIN_EMAIL=admin@sterlingedgetrade.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Business rules 
WITHDRAWAL_FEE_PERCENT=5
MIN_WITHDRAWAL_USD=10
MIN_DEPOSIT_USD=250
